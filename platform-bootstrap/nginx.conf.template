# Use only after university security scan and authorization.
server {
    listen 80;
    server_name example.university.edu.cn;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name example.university.edu.cn;
    ssl_certificate /etc/ssl/agri/fullchain.pem;
    ssl_certificate_key /etc/ssl/agri/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    client_max_body_size 20m;
    root /srv/agricultural-diagnostic-platform/apps/web/dist;
    index index.html;
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
